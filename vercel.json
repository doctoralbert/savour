{
  "functions": {
    "api/ai-import.js": {
      "maxDuration": 60
    },
    "api/recept.js": {
      "includeFiles": "{index.html,assets/fonts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/r/:slug/preview.png",
      "destination": "/api/recept?slug=:slug&img=1"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/recept?slug=:slug"
    },
    {
      "source": "/join/:public_key",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/nl",
      "destination": "/index.html"
    },
    {
      "source": "/pro",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/site/index-en.html"
    },
    {
      "source": "/eng",
      "destination": "/site/index-en.html"
    },
    {
      "source": "/english",
      "destination": "/site/index-en.html"
    },
    {
      "source": "/nld",
      "destination": "/index.html"
    },
    {
      "source": "/de",
      "destination": "/site/index-de.html"
    },
    {
      "source": "/deu",
      "destination": "/site/index-de.html"
    },
    {
      "source": "/it",
      "destination": "/index.html"
    },
    {
      "source": "/ita",
      "destination": "/index.html"
    },
    {
      "source": "/es",
      "destination": "/site/index-es.html"
    },
    {
      "source": "/esp",
      "destination": "/site/index-es.html"
    },
    {
      "source": "/en/blog/:post",
      "destination": "/site/en/blog/:post/index.html"
    },
    {
      "source": "/en/:page",
      "destination": "/site/en/:page/index.html"
    },
    {
      "source": "/de/blog/:post",
      "destination": "/site/de/blog/:post/index.html"
    },
    {
      "source": "/de/:page",
      "destination": "/site/de/:page/index.html"
    },
    {
      "source": "/es/blog/:post",
      "destination": "/site/es/blog/:post/index.html"
    },
    {
      "source": "/es/:page",
      "destination": "/site/es/:page/index.html"
    },
    {
      "source": "/blog/:post",
      "destination": "/site/blog/:post/index.html"
    },
    {
      "source": "/:page",
      "destination": "/site/:page/index.html"
    }
  ]
}
